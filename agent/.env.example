# Copie ce fichier en .env puis mets ta vraie clé (le fichier .env n'est jamais envoyé sur GitHub)
GROQ_API_KEY=gsk_remplace_moi
LLM_MODEL=openai/gpt-oss-120b
# Namespace Kubernetes surveillé par défaut
NAMESPACE=jobradar
MAX_TOOL_CALLS=14
# Prometheus (lancer le port-forward avant l enquête)
PROMETHEUS_URL=http://localhost:9090
# Clone local du dépôt GitOps (utilisé pour git revert, après ta validation)
GITOPS_REPO_PATH=~/projects/jobradar-gitops
# Optionnel : token GitHub pour lire l'historique sans limite stricte (sinon 60 requêtes/heure)
# GITHUB_TOKEN=  (ou : export GITHUB_TOKEN=$(gh auth token))
